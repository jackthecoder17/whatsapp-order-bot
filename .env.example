# Copy this file to .env and fill it in, then run: npm run live

# From Meta → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret phrase you choose; type the same one into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=pick-any-secret-phrase

# Required once WhatsApp is connected — protects /dashboard
DASHBOARD_PASSWORD=

# Your own number (country code, no +) to get new-order alerts, e.g. 2348012345678
OWNER_WHATSAPP=

# Optional: real Paystack payment links
PAYSTACK_SECRET_KEY=
PAYSTACK_FALLBACK_EMAIL=orders@yourbusiness.com
